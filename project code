import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
import joblib

# 1. Random Seed & Samples
np.random.seed(42)
n_samples = 500

# 2. Raw Variables Generate Karte Hain
tenure = np.random.randint(1, 72, n_samples)
monthly_charges = np.random.uniform(20.0, 120.0, n_samples)
contract_type = np.random.choice(['Month-to-Month', 'One Year', 'Two Year'], size=n_samples, p=[0.5, 0.3, 0.2])
payment_methods = np.random.choice(['Electronic Check', 'Mailed Check', 'Bank Withdrawal', 'Credit Card'], size=n_samples, p=[0.3, 0.3, 0.2, 0.2])
support_tickets = np.random.randint(0, 10, n_samples)

# 3. Target Variable Logic
churn_prob = (0.4 * (contract_type == 'Month-to-Month') +
              0.3 * (support_tickets / 10) +
              0.3 * (monthly_charges / 120) -
              0.4 * (tenure / 72))

churn = (churn_prob + np.random.normal(0, 0.1, n_samples) > 0.3).astype(int)

# 4. DataFrame Build
df = pd.DataFrame({
    'tenure': tenure,
    'monthly_charges': monthly_charges,
    'contract_type': contract_type,
    'payment_methods': payment_methods,
    'support_tickets': support_tickets,
    'churn': churn
})

# 5. Features (x) and Target (y)
x = df.drop(columns=['churn'])
y = df['churn']

num_features = ['tenure', 'monthly_charges', 'support_tickets']
cat_features = ['contract_type', 'payment_methods']

# 6. Column Transformer (Handling Numeric & Categorical Data)
preprocessor = ColumnTransformer(transformers=[
    ('num', StandardScaler(), num_features),
    ('cat', OneHotEncoder(drop='first'), cat_features)
])

# 7. Pipeline Construction
model_pipeline = Pipeline(steps=[
    ('preprocessor', preprocessor),
    ('classifier', RandomForestClassifier(random_state=42))
])

# 8. Train-Test Split
x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.2, random_state=42)

# 9. Hyperparameter Tuning
param_grid = {
    'classifier__n_estimators': [50, 100],
    'classifier__max_depth': [3, 5, None]
}

grid = GridSearchCV(model_pipeline, param_grid, cv=5, scoring='accuracy', n_jobs=-1)
grid.fit(x_train, y_train)

# 10. Results & Evaluation
best_model = grid.best_estimator_
y_pred = best_model.predict(x_test)

print(f"Accuracy: {accuracy_score(y_test, y_pred) * 100:.2f}%\n")
print("Classification Report:\n", classification_report(y_test, y_pred))

# 11. Save Trained Model
joblib.dump(best_model, 'churn_model_pipeline.pkl')
print("Model Saved Successfully as 'churn_model_pipeline.pkl'!")